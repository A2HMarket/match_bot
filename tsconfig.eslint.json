{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowJs": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "scripts/**/*.mjs", "*.ts", "*.js"],
  "exclude": ["**/dist/**", "**/node_modules/**", "**/generated/**"]
}
