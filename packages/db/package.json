{
  "name": "@matchbot/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema、迁移、仓储层。唯一允许直接访问 Postgres 的包",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --root ../.. --dir packages/db",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.16.0",
    "zod": "^4.6.5",
    "@matchbot/shared": "workspace:*",
    "@matchbot/domain": "workspace:*"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "@types/pg": "^8.15.0"
  }
}
