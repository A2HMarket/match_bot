# ---- 基础设施 ----
DATABASE_URL=postgresql://matchbot:matchbot@localhost:5432/matchbot
REDIS_URL=redis://localhost:6379

# ---- 模型 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=            # 运营审批群 chat id（Phase 1 审批台）

# ---- 运行 ----
NODE_ENV=development
LOG_LEVEL=info
DEFAULT_PHASE=0                  # 0 shadow / 1 review / 2 auto；群级配置可覆盖
